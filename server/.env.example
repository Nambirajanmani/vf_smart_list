# Server Environment Variables
# Copy this file to .env and fill in your actual values

PORT=5000
FRONTEND_URL=https://vf-smart-list-1.onrender.com

# PostgreSQL connection (DATABASE_URL for Neon Cloud / Heroku, or individual DB_* params for local)
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vf_smart_list
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT secret (change this to a long random string in production)
JWT_SECRET=vf_smart_list_super_secret_jwt_key_2024

# Admin seed credentials (used on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
